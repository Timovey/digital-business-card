# --- Приложение ---
NODE_ENV=development
PORT=3000
# Порт хоста для контейнера API (docker compose)
API_PORT=3000
# GraphiQL на GET /graphql + интроспекция (включены: здесь IDE и есть витрина API)
GRAPHQL_SANDBOX=true
# Лимиты сложности GraphQL-запроса, подробно: docs/graphql-query-limits.md
GRAPHQL_MAX_DEPTH=6
GRAPHQL_MAX_ALIASES=15
GRAPHQL_MAX_COST=1000
# Логировать SQL-запросы Prisma (удобно, чтобы видеть батчинг DataLoader)
PRISMA_LOG_QUERIES=false

# --- PostgreSQL ---
POSTGRES_USER=card
POSTGRES_PASSWORD=card
POSTGRES_DB=card
POSTGRES_PORT=5433
DATABASE_URL=postgresql://card:card@localhost:5433/card?schema=public

# --- S3 (локально RustFS, в продакшене любое S3-совместимое хранилище) ---
S3_ENDPOINT=http://localhost:9000
# Endpoint S3, доступный браузеру: из него строятся публичные ссылки (аватар).
# Внутри Docker отличается от S3_ENDPOINT: там API обращается к `http://s3:9000`.
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Необязательно: базовый адрес публичных объектов (CDN, домен Cloudflare R2), без имени бакета.
S3_PUBLIC_URL=
S3_REGION=us-east-1
S3_BUCKET=business-card
S3_ACCESS_KEY=card-access-key
S3_SECRET_KEY=card-secret-key
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001
