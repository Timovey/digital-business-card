# Production-окружение для deploy/docker-compose.yml. Скопируйте в deploy/.env и заполните.
# deploy/.env не коммитится (.gitignore). Секреты генерируйте, например: openssl rand -hex 24

# Домен, A-запись которого указывает на IP сервера. Caddy выпустит для него сертификат.
DOMAIN=card.example.com
# Почта для Let's Encrypt (уведомления о проблемах с сертификатом).
ACME_EMAIL=you@example.com

POSTGRES_USER=card
POSTGRES_PASSWORD=change-me
POSTGRES_DB=card

S3_BUCKET=business-card
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Корневых GraphQL-полей на один IP в минуту; 0 — без ограничения.
RATE_LIMIT_PER_MINUTE=120
